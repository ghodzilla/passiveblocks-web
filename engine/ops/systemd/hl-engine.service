[Unit]
Description=Hyperliquid engine, simulation replay only, no orders
Documentation=file:/opt/hl-engine/app/ops/README.md
OnFailure=pb-alert@%n.service

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=60
Restart=always
RestartSec=30
TimeoutStartSec=180
User=hlengine
Group=hlengine
Slice=hl-engine.slice
WorkingDirectory=/opt/hl-engine/app
ExecStart=/opt/hl-engine/app/ops/hl-engine-sim
Nice=10
OOMScoreAdjust=400
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/hl-engine /var/log/hl-engine
ReadOnlyPaths=/opt/hl-engine
StateDirectory=hl-engine
LogsDirectory=hl-engine
StateDirectoryMode=0750
LogsDirectoryMode=0750
Environment=PYTHONDONTWRITEBYTECODE=1
StandardOutput=append:/var/log/hl-engine/hl-engine.log
StandardError=append:/var/log/hl-engine/hl-engine.log

[Install]
WantedBy=multi-user.target
