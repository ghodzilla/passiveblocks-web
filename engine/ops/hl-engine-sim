#!/bin/bash
# Live paper loop. Public mainnet info and websocket only.
# Nothing here sends an order or prints a connection string.
# SQLite is the local book. A database URL, when systemd supplies one,
# is read by the engine and is not echoed.

set -euo pipefail
umask 027

ENGINE=/opt/hl-engine/.venv/bin/pb-engine
DB=/var/lib/hl-engine/pb-engine.sqlite3
LOCK=/var/lib/hl-engine/hl-engine.lock

case "$DB" in
  /var/lib/hl-engine/*) ;;
  *)
    echo "database path is outside /var/lib/hl-engine" >&2
    exit 2
    ;;
esac

if [[ -n "${NOTIFY_SOCKET:-}" ]] && ! command -v systemd-notify >/dev/null 2>&1; then
  echo "systemd-notify is required for Type=notify" >&2
  exit 1
fi

notify() {
  if command -v systemd-notify >/dev/null 2>&1; then
    systemd-notify "$@" || true
  fi
}

mkdir -p /var/lib/hl-engine /var/log/hl-engine
touch "$LOCK"
exec 9<>"$LOCK"
if ! flock -n 9; then
  echo "hl-engine paper loop is already running" >&2
  exit 1
fi

notify --ready
notify WATCHDOG=1
echo "live paper loop. orders=none. keys=none. NOT VALIDATED."

last_prune=$(date +%s)
while true; do
  notify WATCHDOG=1
  if ! "$ENGINE" run-once --live-data --db "$DB" --seed 1; then
    echo "cycle failed. staying up. nothing was sent." >&2
  fi
  now=$(date +%s)
  if (( now - last_prune >= 3600 )); then
    "$ENGINE" prune --db "$DB" || echo "prune skipped" >&2
    last_prune=$now
  fi
  sleep 15
done
